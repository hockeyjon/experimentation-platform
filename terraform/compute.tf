# ---------------------------------------------------------------------------
# Backend: EC2 instance running the Docker Compose stack, plus its security
# group and a stable Elastic IP. Mirrors the manual provisioning script.
# ---------------------------------------------------------------------------

# Latest Amazon Linux 2023 AMI (same SSM parameter we used by hand).
data "aws_ssm_parameter" "al2023" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

# SSH key pair, generated by Terraform. The private key is written to ~/.ssh so you
# can SSH in immediately after apply — no separate `aws ec2 create-key-pair` step.
resource "tls_private_key" "ec2" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "ec2" {
  key_name   = var.key_name
  public_key = tls_private_key.ec2.public_key_openssh
}

resource "local_sensitive_file" "ec2_pem" {
  content         = tls_private_key.ec2.private_key_pem
  filename        = pathexpand("~/.ssh/${var.key_name}.pem")
  file_permission = "0400"
}

# Security group: SSH from you only; 80/443 public; DB ports intentionally closed.
resource "aws_security_group" "backend" {
  name        = "experimentation-backend-sg"
  description = "Experimentation backend: SSH from admin, 80/443 public"

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_ingress_cidr]
  }

  ingress {
    description = "HTTP (Caddy ACME + redirect)"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS (Caddy to API)"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "All outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "backend" {
  ami                    = data.aws_ssm_parameter.al2023.value
  instance_type          = var.instance_type
  key_name               = aws_key_pair.ec2.key_name
  vpc_security_group_ids = [aws_security_group.backend.id]

  root_block_device {
    volume_size = var.root_volume_gb
    volume_type = "gp3"
  }

  # Runs as root at first boot: installs Docker + Compose + Buildx and adds swap.
  # (Deploying the app code itself — rsync + docker compose up — stays a manual/CI
  # step, same as we did.) Note the $$ escapes: Terraform leaves $${VAR} as ${VAR}
  # for the shell.
  user_data = <<-EOF
    #!/usr/bin/env bash
    set -euo pipefail
    dnf install -y docker
    systemctl enable --now docker
    usermod -aG docker ec2-user

    mkdir -p /usr/libexec/docker/cli-plugins
    curl -SL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" -o /usr/libexec/docker/cli-plugins/docker-compose
    chmod +x /usr/libexec/docker/cli-plugins/docker-compose

    BUILDX_VER=$(curl -s https://api.github.com/repos/docker/buildx/releases/latest | grep '"tag_name"' | cut -d'"' -f4)
    curl -SL "https://github.com/docker/buildx/releases/download/$${BUILDX_VER}/buildx-$${BUILDX_VER}.linux-amd64" -o /usr/libexec/docker/cli-plugins/docker-buildx
    chmod +x /usr/libexec/docker/cli-plugins/docker-buildx

    if [ ! -f /swapfile ]; then
      dd if=/dev/zero of=/swapfile bs=1M count=2048
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi
  EOF

  tags = {
    Name = "experimentation-backend"
  }
}

# Stable public IP so stop/start doesn't change the address (the `api` A record).
resource "aws_eip" "backend" {
  instance = aws_instance.backend.id
  domain   = "vpc"
}
