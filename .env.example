# Copy to api/.env before running the API.
# These match the credentials in docker-compose.yml.

# Postgres (Aurora stand-in) — used by Prisma
DATABASE_URL="postgresql://experimentation:experimentation@localhost:5433/experiments?schema=public"

# MongoDB (DocumentDB stand-in) — used for event logging
MONGO_URL="mongodb://localhost:27017"
MONGO_DB="experiments_events"

# Redis — assignment cache
REDIS_URL="redis://localhost:6379"

# API port
PORT=4000
